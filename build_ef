#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/scripts/common.sh"

if [[ $# -ne 0 ]]; then
    printf 'Usage: %s\n' "$0" >&2
    exit 2
fi

load_firmware_tools
idf.py -C "$PROJECT_ROOT/firmware" build
printf '\nFirmware built: %s/firmware/build/audio_broadcaster.bin\n' "$PROJECT_ROOT"
